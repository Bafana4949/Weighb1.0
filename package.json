{
  "name": "weighbridge-system",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "packages/database",
    "packages/shared-types",
    "packages/mqtt-topics"
  ],
  "scripts": {
    "dev:web": "npm --workspace @weighbridge/web run dev",
    "build": "npm --workspace @weighbridge/database run generate && npm --workspace @weighbridge/web run build",
    "db:generate": "npm --workspace @weighbridge/database run generate",
    "db:migrate": "npm --workspace @weighbridge/database run migrate:dev",
    "db:push": "npm --workspace @weighbridge/database run push",
    "db:seed": "npm --workspace @weighbridge/database run seed",
    "demo:auto": "bash scripts/run-auto-weighment.sh",
    "test": "npm --workspace @weighbridge/web run test",
    "preflight": "node preflight.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "next": "^15.2.4"
  }
}
