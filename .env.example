# =============================================================================
# Weighbridge platform - environment template
#
# Copy to `.env` in the repository root. The web app (apps/web/next.config.mjs),
# the Prisma runner (packages/database/prisma-runner.js) and the seed script all
# read this root file, and its values OVERRIDE variables already set in the shell.
#
# Values below are development placeholders only. Never commit real secrets.
#
# IMPORTANT: leave optional variables COMMENTED OUT rather than empty. Several are
# read with `??`, so an empty value (VAR=) replaces the built-in default with "".
#
# NODE_ENV, VERCEL and NEXT_PHASE are set by the runtime/platform; do not set them here.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Database
# -----------------------------------------------------------------------------
# Pooled connection used by the app. Local compose database shown; for Supabase use
# the pooler (port 6543) with ?pgbouncer=true.
DATABASE_URL=postgresql://weighbridge:weighbridge_dev_change_me@127.0.0.1:15432/weighbridge?schema=public
# Direct connection used by Prisma migrations. For Supabase use port 5432.
DIRECT_URL=postgresql://weighbridge:weighbridge_dev_change_me@127.0.0.1:15432/weighbridge?schema=public

# docker-compose.yml: database container settings. Keep in step with the URLs above.
POSTGRES_DB=weighbridge
POSTGRES_USER=weighbridge
POSTGRES_PASSWORD=weighbridge_dev_change_me
# Host port for PostgreSQL (bound to 127.0.0.1). Configurable because Windows Hyper-V
# reserves port ranges: check `netsh interface ipv4 show excludedportrange protocol=tcp`.
POSTGRES_HOST_PORT=15432


# -----------------------------------------------------------------------------
# 2. Authentication and secrets
# -----------------------------------------------------------------------------
# JWT signing secret; also the key source for encrypted driver ID numbers.
# Production refuses to start without it or with a placeholder ("change-me",
# "replace-with", "change-before-production"). Generate: openssl rand -base64 48
# Rotating it signs everyone out and makes stored encrypted ID numbers unreadable.
AUTH_SECRET=replace-with-at-least-32-random-characters
# NEXTAUTH_SECRET=                       # accepted as a fallback name for AUTH_SECRET
AUTH_TRUST_HOST=true
# Public base URL: password-reset links and waybill QR verification links.
NEXT_PUBLIC_APP_URL=http://localhost:3010
# Pepper for hashing password-reset tokens and driver ID-number lookups (not passwords,
# which use bcrypt). Keep it stable: changing it breaks existing lookups and reset links.
PASSWORD_PEPPER=dev-pepper-change-me


# -----------------------------------------------------------------------------
# 3. Seeding
# -----------------------------------------------------------------------------
# packages/database/seed.ts creates the platform super admin.
# Email defaults to superadmin@weighbridge.co.za. Password: at least 12 characters;
# if unset, a random one is generated and printed once. Re-running the seed never
# resets an existing account's password. Remove the password from .env after use.
# SEED_SUPERADMIN_EMAIL=superadmin@example.co.za
# SEED_SUPERADMIN_PASSWORD=replace-with-a-strong-password

# packages/database/seed-demo.ts and scripts/e2e-personas.mjs (demo databases only;
# seed-demo refuses databases whose name lacks "demo"). Generated if unset.
# DEMO_PASSWORD=replace-with-demo-password
# BASE_URL=http://localhost:3010         # e2e-personas.mjs target


# -----------------------------------------------------------------------------
# 4. MQTT
# -----------------------------------------------------------------------------
# Broker the web app publishes notifications to (default mqtt://localhost:1883).
# Production: mqtts://weighbridge-cloud:<password>@<broker>:8883
# The compose `cloud` profile sets this itself (mqtt://mosquitto:1883).
# MQTT_URL=mqtt://localhost:1883


# -----------------------------------------------------------------------------
# 5. Co-located edge controller (optional)
# -----------------------------------------------------------------------------
# Only when this web server sits on the same LAN as ONE site's edge controller.
# Enables live edge data for the kiosk and operator gate/light commands
# (/api/edge/live, /api/edge/command, /api/edge/driver-decision). Leave unset for a
# cloud deployment.
# SITE_DAEMON_URL=http://127.0.0.1:8000
# SITE_DAEMON_SITE_CODE=SITE-CODE
# Sent as x-edge-token; must equal the edge's WB_LOCAL_API_TOKEN.
# (The compose `cloud` profile fills SITE_DAEMON_TOKEN from WB_LOCAL_API_TOKEN.)
# SITE_DAEMON_TOKEN=replace-with-edge-local-token


# -----------------------------------------------------------------------------
# 6. Legacy shared edge key (upgrade window only)
# -----------------------------------------------------------------------------
# Per-site keys (wbe_...) are issued in Hardware -> Configuration. The old shared key
# is accepted only when ALLOW_LEGACY_SITE_KEY=true, it is at least 24 characters and
# not a "change-me" placeholder. Not accepted by /api/edge/config or /api/edge/heartbeat.
# Remove both once every edge has a per-site key.
# ALLOW_LEGACY_SITE_KEY=false
# SITE_DAEMON_API_KEY=replace-with-old-shared-key


# -----------------------------------------------------------------------------
# 7. Local NFC bridge
# -----------------------------------------------------------------------------
# Where the web SERVER forwards card reads (/api/nfc/uid). Default http://127.0.0.1:7777,
# i.e. the bridge must run on the same machine as the web server.
# NFC_BRIDGE_URL=http://127.0.0.1:7777


# -----------------------------------------------------------------------------
# 8. Attachments
# -----------------------------------------------------------------------------
# Directory for service-order attachments. Default: .attachments in the web app's
# working directory. Use a persistent, backed-up path in production.
# ATTACHMENT_STORAGE_PATH=/var/lib/weighbridge/attachments


# -----------------------------------------------------------------------------
# 9. Email (password reset, notifications). Email is skipped unless SMTP_HOST and
#    SMTP_USER are set. Port 465 uses implicit TLS.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.test
SMTP_PORT=587
# SMTP_USER=replace-with-smtp-user
# SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Weighbridge Platform <noreply@example.test>


# -----------------------------------------------------------------------------
# 10. SMS via Twilio (optional; used only when all three are set)
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace-with-twilio-token
# TWILIO_FROM_NUMBER=+27000000000


# -----------------------------------------------------------------------------
# 11. Supabase client (optional)
# -----------------------------------------------------------------------------
# Read by apps/web/src/lib/supabase.ts, which no route imports today. The database
# connection for Supabase is configured with DATABASE_URL / DIRECT_URL above.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key


# -----------------------------------------------------------------------------
# 12. Other web variables
# -----------------------------------------------------------------------------
# Socket.IO URL for in-app notifications. No Socket.IO server exists in this
# repository; leave unset.
# NEXT_PUBLIC_SOCKET_URL=


# -----------------------------------------------------------------------------
# 13. Tools
# -----------------------------------------------------------------------------
# pgAdmin (compose profile `admin-tools`, http://127.0.0.1:5050)
# PGADMIN_EMAIL=admin@weighbridge.local
# PGADMIN_PASSWORD=replace-with-pgadmin-password

# scripts/backup/*.sh
# POSTGRES_CONTAINER=weighbridge-system-postgres-1
# BACKUP_ENCRYPTION_KEY=replace-with-backup-passphrase
# BACKUP_RETENTION_COUNT=30


# =============================================================================
# EDGE CONTROLLER (apps/site-daemon) - reference only
#
# These belong in the ENVIRONMENT OF THE EDGE PC (for example
# /etc/weighbridge/edge.env), not in the cloud's .env. They are listed here so the
# whole system is documented in one place. docker-compose.yml also reads
# WB_SITE_API_KEY, WB_SITE_API_KEY_DUAL, WB_CLOUD_API_URL, WB_LOCAL_API_TOKEN and
# INSTALL_ANPR from this file for the simulated `edge` / `edge-dual` profiles.
# See docs/EDGE_DEPLOYMENT.md.
# =============================================================================
# WB_ENV=production                      # production (default) or development
# WB_SITE_API_KEY=wbe_replace-with-issued-key
# WB_SITE_API_KEY_DUAL=wbe_replace-with-issued-key   # compose edge-dual profile only
# WB_CLOUD_API_URL=https://weighbridge.example.co.za/api
# WB_MQTT_URL=mqtts://mqtt.example.co.za:8883
# WB_MQTT_USERNAME=<site uuid>
# WB_MQTT_PASSWORD=replace-with-broker-password
# WB_MQTT_TLS_CA=/etc/weighbridge/ca.crt
# WB_MQTT_TLS_CERT=/etc/weighbridge/edge.crt        # mutual TLS only
# WB_MQTT_TLS_KEY=/etc/weighbridge/edge.key         # mutual TLS only
# WB_LOCAL_API_TOKEN=replace-with-long-random-token
# WB_CONFIG_PATH=/etc/weighbridge/edge.yaml
# WB_EDGE_DB_PATH=/data/edge.db
# WB_ALLOW_SIMULATION=false              # true ONLY for simulator test rigs
# WB_HTTP_HOST=127.0.0.1                 # default 0.0.0.0
# WB_HTTP_PORT=8000
# WB_CORS_ORIGINS=                       # comma-separated origins; empty = no CORS
# LOG_LEVEL=INFO
# INSTALL_ANPR=false                     # compose build arg: true adds EasyOCR/torch
