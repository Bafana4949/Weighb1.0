# Database (Supabase PostgreSQL or local Postgres)
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# NextAuth / Application Authentication
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3010
PASSWORD_PEPPER=dev-pepper-change-me

# Optional Email / Notification Config
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Weighbridge Platform <noreply@example.test>
