c# Cloud database
POSTGRES_DB=weighbridge
POSTGRES_USER=weighbridge
POSTGRES_PASSWORD=weighbridge_dev_change_me
DATABASE_URL=postgresql://weighbridge:weighbridge_dev_change_me@localhost:5432/weighbridge?schema=public

# Auth.js / application
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_DAEMON_API_KEY=dev-site-key-change-me
PASSWORD_PEPPER=dev-pepper-change-me

# MQTT
MQTT_URL=mqtt://localhost:1883
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Email (Ethereal is suitable for development)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Weighbridge Platform <noreply@example.test>

# SMS (Twilio). Leave blank to fall back to a console log placeholder.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Edge daemon overrides
WB_CONFIG_PATH=apps/site-daemon/config.yaml
WB_CLOUD_API_URL=http://localhost:3000/api
WB_EDGE_DB_PATH=apps/site-daemon/edge.db
