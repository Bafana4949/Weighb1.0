generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model Permission {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  description     String
  category        String
  createdAt       DateTime @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @db.Uuid @map("organisation_id")
  name           String
  isBuiltIn      Boolean  @default(false) @map("is_built_in")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  assignments    UserRoleAssignment[]

  @@unique([organisationId, name])
  @@map("roles")
}

model RolePermission {
  roleId       String     @db.Uuid @map("role_id")
  permissionId String     @db.Uuid @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  roleId    String   @db.Uuid @map("role_id")
  siteId    String?  @db.Uuid @map("site_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, siteId])
  @@map("user_role_assignments")
}

model UserSiteAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  siteId    String   @db.Uuid @map("site_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@map("user_site_access")
}

enum OrganisationType {
  MINING_COMPANY
  HAULIER
  SERVICE_PROVIDER
}

enum ClientOrganisationStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_SUPPORT
}

enum WeighbridgeTopology {
  BIDIRECTIONAL_SINGLE
  DUAL_ENTRY_EXIT
}

enum ServiceOrderCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  ANPR
  SCALE
  GATE
  PRINTER
  REPORTING
  USER_ACCESS
  CALIBRATION
  TRAINING
  OTHER
}

enum ServiceOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ServiceOrderStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  WAITING_FOR_CLIENT
  RESOLVED
  CLOSED
  CANCELLED
}

enum ServiceOrderSource {
  PLATFORM_ADMIN
  CLIENT_USER
  AUTOMATED_ALERT
}

model ServiceOrder {
  id              String               @id @default(uuid()) @db.Uuid
  orderNumber     String               @unique @map("order_number")
  organisationId  String               @db.Uuid @map("organisation_id")
  siteId          String?              @db.Uuid @map("site_id")
  title           String
  description     String
  category        ServiceOrderCategory
  priority        ServiceOrderPriority @default(MEDIUM)
  status          ServiceOrderStatus   @default(OPEN)
  source          ServiceOrderSource
  createdById     String               @db.Uuid @map("created_by_id")
  assignedToId    String?              @db.Uuid @map("assigned_to_id")
  contactName     String?              @map("contact_name")
  contactPhone    String?              @map("contact_phone")
  contactEmail    String?              @map("contact_email")
  deviceId        String?              @db.Uuid @map("device_id")
  transactionId   String?              @db.Uuid @map("transaction_id")
  incidentId      String?              @db.Uuid @map("incident_id")
  dueAt           DateTime?            @map("due_at")
  acknowledgedAt  DateTime?            @map("acknowledged_at")
  startedAt       DateTime?            @map("started_at")
  resolvedAt      DateTime?            @map("resolved_at")
  closedAt        DateTime?            @map("closed_at")
  resolutionNotes String?              @map("resolution_notes")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  organisation    Organisation         @relation(fields: [organisationId], references: [id])
  site            Site?                @relation(fields: [siteId], references: [id])
  createdBy       User                 @relation("ServiceOrderCreator", fields: [createdById], references: [id])
  assignedTo      User?                @relation("ServiceOrderAssignee", fields: [assignedToId], references: [id])
  comments        ServiceOrderComment[]
  attachments     ServiceOrderAttachment[]

  @@index([organisationId, status, createdAt])
  @@index([assignedToId, status])
  @@map("service_orders")
}

model ServiceOrderComment {
  id             String       @id @default(uuid()) @db.Uuid
  serviceOrderId String       @db.Uuid @map("service_order_id")
  authorId       String       @db.Uuid @map("author_id")
  body           String
  isInternal     Boolean      @default(false) @map("is_internal")
  createdAt      DateTime     @default(now()) @map("created_at")
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id])

  @@index([serviceOrderId, createdAt])
  @@map("service_order_comments")
}

model ServiceOrderAttachment {
  id             String       @id @default(uuid()) @db.Uuid
  serviceOrderId String       @db.Uuid @map("service_order_id")
  uploadedById   String       @db.Uuid @map("uploaded_by_id")
  fileName       String       @map("file_name")
  contentType    String       @map("content_type")
  sizeBytes      Int          @map("size_bytes")
  storageKey     String       @map("storage_key")
  createdAt      DateTime     @default(now()) @map("created_at")
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])

  @@index([serviceOrderId, createdAt])
  @@map("service_order_attachments")
}

enum SiteType {
  MINE
  WEIGHBRIDGE
  DEPOT
  CUSTOMER_SITE
}

enum OrderType {
  DISPATCH
  RECEIPT
}

enum OrderStatus {
  DRAFT
  ACTIVE
  FULFILLED
  CANCELLED
}

enum UserRole {
  TRANSPORTER
  OPERATOR
  ADMIN
  SECURITY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum VehicleStatus {
  ACTIVE
  SUSPENDED
  MAINTENANCE
  EXPIRED_DOCUMENTS
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
  EXPIRED
}

enum TransactionStatus {
  IN_PROGRESS
  COMPLETED
  HELD
  VOIDED
  MANUAL_REVIEW
}

enum TransactionType {
  INBOUND
  OUTBOUND
  DELIVERY
  COLLECTION
  FIRST_WEIGH
  SECOND_WEIGH
  GROSS_ONLY
  TARE_ONLY
  INTERNAL_TRANSFER
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

enum GateDirection {
  ENTRY
  EXIT
}

enum GateEventType {
  ANPR_CAPTURE
  AUTHORISATION_CHECK
  GATE_OPEN
  GATE_CLOSE
  VEHICLE_ENTERED
  VEHICLE_EXITED
  MANUAL_OVERRIDE
}

enum IncidentType {
  UNAUTHORISED_ACCESS
  OVERLOAD
  FRAUD_ALERT
  SENSOR_FAULT
  DRIVER_MISMATCH
  ANPR_FAILURE
  CLOUD_SYNC_FAILURE
  SCALE_FAULT
  ROUTE_DEVIATION
  CLONE_DETECTION
  TARE_DRIFT
  CALIBRATION_EXPIRY
  POWER_RECOVERY
  MANUAL_OVERRIDE
  UNDERWEIGHT_EMPTY
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum HardwareDeviceType {
  SCALE
  POSITION_SENSOR
  RFID_READER
  ANPR_CAMERA
  ENTRY_GATE
  EXIT_GATE
  TRAFFIC_LIGHT
  BUZZER
  EDGE_DAEMON
  PRINTER
}

enum HardwareHealth {
  ONLINE
  DEGRADED
  OFFLINE
  FAULT
}

enum QueueOperation {
  TRANSACTION_RECONCILE
  GATE_EVENT_UPLOAD
  INCIDENT_UPLOAD
  HARDWARE_STATUS_UPLOAD
}

enum NotificationChannel {
  DASHBOARD
  EMAIL
  SMS
  AUDIBLE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Organisation {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  code            String?            @unique
  registrationNo  String?            @unique @map("registration_no")
  type            OrganisationType
  contactEmail    String?            @map("contact_email")
  contactPhone    String?            @map("contact_phone")
  isActive        Boolean            @default(true) @map("is_active")
  status          ClientOrganisationStatus @default(ACTIVE) @map("status")
  suspendedAt     DateTime?          @map("suspended_at")
  suspensionReason String?           @map("suspension_reason")
  legalName       String?            @map("legal_name")
  tradingName     String?            @map("trading_name")
  taxNumber       String?            @unique @map("tax_number")
  physicalAddress String?            @map("physical_address")
  postalAddress   String?            @map("postal_address")
  logoUrl         String?            @map("logo_url")
  timezone        String?            @default("Africa/Johannesburg")
  defaultCurrency String?            @default("ZAR") @map("default_currency")
  onboardedAt     DateTime?          @map("onboarded_at")
  onboardedById   String?            @db.Uuid @map("onboarded_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")
  users           User[]             @relation("OrganisationUsers")
  onboardedBy     User?              @relation("OrganisationOnboardedBy", fields: [onboardedById], references: [id])
  vehicles        Vehicle[]
  drivers         Driver[]
  sites           Site[]             @relation("SiteOwner")
  transporterBookings Booking[]      @relation("TransporterOrganisation")
  serviceOrders   ServiceOrder[]
  vehicleAssignments VehicleTransporterAssignment[]
  roles           Role[]
  sources         Source[]
  destinations    Destination[]
  products        Product[]
  rfidCredentials RfidCredential[]
  weighbridgeInstallations WeighbridgeInstallation[]
  fleetRosters    FleetRoster[]

  miningCompanyTransporters   MiningCompanyTransporter[] @relation("MiningCompanyPartners")
  clientMiningCompanies       MiningCompanyTransporter[] @relation("TransporterClients")

  @@index([type, isActive])
  @@map("organisations")
}

model MiningCompanyTransporter {
  id              String       @id @default(uuid()) @db.Uuid
  miningCompanyId String       @db.Uuid @map("mining_company_id")
  transporterId   String       @db.Uuid @map("transporter_id")
  status          String       @default("ACTIVE")
  createdAt       DateTime     @default(now()) @map("created_at")

  miningCompany   Organisation @relation("MiningCompanyPartners", fields: [miningCompanyId], references: [id], onDelete: Cascade)
  transporter     Organisation @relation("TransporterClients", fields: [transporterId], references: [id], onDelete: Cascade)

  @@unique([miningCompanyId, transporterId])
  @@map("mining_company_transporters")
}

model Site {
  id                    String               @id @default(uuid()) @db.Uuid
  organisationId        String               @db.Uuid @map("organisation_id")
  code                  String               @unique
  name                  String
  type                  SiteType             @default(MINE)
  address               String
  latitude              Decimal              @db.Decimal(10, 7)
  longitude             Decimal              @db.Decimal(10, 7)
  timezone              String               @default("Africa/Johannesburg")
  geofenceRadiusM       Int                  @default(500) @map("geofence_radius_m")
  topology              WeighbridgeTopology  @default(BIDIRECTIONAL_SINGLE)
  isActive              Boolean              @default(true) @map("is_active")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  organisation          Organisation         @relation("SiteOwner", fields: [organisationId], references: [id])
  config                SiteConfig?
  bookings              Booking[]
  transactions          WeighbridgeTransaction[]
  gateEvents            GateEvent[]
  incidents             Incident[]
  hardwareDevices       HardwareDevice[]
  hardwareStatuses      HardwareStatus[]
  syncQueue             SyncQueue[]
  calibrationCertificates CalibrationCertificate[]
  systemLogs            SystemLog[]
  weighbridgeOrders     WeighbridgeOrder[]   @relation("OrderWeighbridge")
  originOrders          WeighbridgeOrder[]   @relation("OrderOrigin")
  destinationOrders     WeighbridgeOrder[]   @relation("OrderDestination")
  lanes                 Lane[]
  serviceOrders         ServiceOrder[]
  userRoleAssignments   UserRoleAssignment[]
  userSiteAccess        UserSiteAccess[]
  weighbridgeInstallation WeighbridgeInstallation?
  rfidCredentials       RfidCredential[]

  @@index([organisationId, isActive])
  @@map("sites")
}

model Lane {
  id         String         @id @default(uuid()) @db.Uuid
  siteId     String         @db.Uuid @map("site_id")
  laneNumber Int            @map("lane_number")
  name       String
  direction  GateDirection?
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  site       Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  hardwareDevices HardwareDevice[]
  transactions WeighbridgeTransaction[]

  @@unique([siteId, laneNumber])
  @@map("lanes")
}

model SiteConfig {
  id                        String   @id @default(uuid()) @db.Uuid
  siteId                    String   @unique @db.Uuid @map("site_id")
  operatingStart            String   @default("05:00") @map("operating_start")
  operatingEnd              String   @default("22:00") @map("operating_end")
  maxCapacityKg             Int      @default(80000) @map("max_capacity_kg")
  stabilityThresholdKg      Int      @default(20) @map("stability_threshold_kg")
  stabilityDurationSeconds  Int      @default(3) @map("stability_duration_seconds")
  overloadTolerancePercent  Decimal  @default(5) @db.Decimal(5, 2) @map("overload_tolerance_percent")
  emptyVehicleMaxKg        Int      @default(18500) @map("empty_vehicle_max_kg")
  loadedVehicleMaxKg       Int      @default(70000) @map("loaded_vehicle_max_kg")
  positioningHoldSeconds    Int      @default(2) @map("positioning_hold_seconds")
  turnaroundThresholdMinutes Int     @default(45) @map("turnaround_threshold_minutes")
  journeyWindowGraceMinutes Int      @default(120) @map("journey_window_grace_minutes")
  autoApprovalEnabled       Boolean  @default(true) @map("auto_approval_enabled")
  requireInsuranceValid     Boolean  @default(true) @map("require_insurance_valid")
  requireDriverLicenceValid Boolean  @default(true) @map("require_driver_licence_valid")
  retentionYears            Int      @default(5) @map("retention_years")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  site                      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_configs")
}

model User {
  id             String      @id @default(uuid()) @db.Uuid
  organisationId String?     @db.Uuid @map("organisation_id")
  email          String      @unique
  passwordHash   String      @map("password_hash")
  firstName      String      @map("first_name")
  lastName       String      @map("last_name")
  phone          String?
  role           UserRole
  platformRole   PlatformRole? @map("platform_role")
  status         UserStatus  @default(ACTIVE)
  lastLoginAt    DateTime?   @map("last_login_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")
  organisation   Organisation? @relation("OrganisationUsers", fields: [organisationId], references: [id])
  onboardedOrganisations Organisation[] @relation("OrganisationOnboardedBy")
  createdBookings Booking[]  @relation("BookingCreator")
  approvedBookings Booking[] @relation("BookingApprover")
  operatedTransactions WeighbridgeTransaction[] @relation("TransactionOperator")
  resolvedIncidents Incident[] @relation("IncidentResolver")
  systemLogs      SystemLog[]
  notifications   Notification[]
  createdOrders   WeighbridgeOrder[]
  passwordResetTokens PasswordResetToken[]
  createdServiceOrders ServiceOrder[] @relation("ServiceOrderCreator")
  assignedServiceOrders ServiceOrder[] @relation("ServiceOrderAssignee")
  serviceOrderComments ServiceOrderComment[]
  serviceOrderAttachments ServiceOrderAttachment[]
  createdVehicleAssignments VehicleTransporterAssignment[]
  roleAssignments UserRoleAssignment[]
  siteAccess      UserSiteAccess[]
  createdSources  Source[]             @relation("SourceCreator")
  createdDestinations Destination[]    @relation("DestinationCreator")
  createdProducts Product[]            @relation("ProductCreator")
  createdRfids    RfidCredential[]     @relation("RfidCreator")

  @@index([organisationId, role, status])
  @@index([platformRole])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Vehicle {
  id                String        @id @default(uuid()) @db.Uuid
  organisationId    String        @db.Uuid @map("organisation_id")
  plate             String
  plateNormalized   String        @map("plate_normalized")
  make              String
  model             String
  year              Int?
  vin               String?       @unique
  tareWeightKg      Int           @default(0) @map("tare_weight_kg")
  legalMaxGvwKg     Int           @map("legal_max_gvw_kg")
  insuranceExpiry   DateTime      @db.Date @map("insurance_expiry")
  status            VehicleStatus @default(ACTIVE)
  anomalyScore      Decimal       @default(0) @db.Decimal(8, 2) @map("anomaly_score")
  lastTareWeightKg  Int?          @map("last_tare_weight_kg")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  organisation      Organisation  @relation(fields: [organisationId], references: [id])
  trailers          Trailer[]
  bookings          Booking[]
  transactions      WeighbridgeTransaction[]
  incidents         Incident[]
  gateEvents        GateEvent[]
  transporterAssignments VehicleTransporterAssignment[]
  rfidCredentials   RfidCredential[]
  fleetRosters      FleetRoster[]

  @@unique([organisationId, plateNormalized])
  @@index([plateNormalized, status])
  @@index([insuranceExpiry])
  @@map("vehicles")
}

enum VehicleAssignmentRelationship {
  OWNER
  PRIMARY_CONTRACTOR
  SUBCONTRACTOR
  TEMPORARY_ASSIGNMENT
  THIRD_PARTY_HAULIER
}

enum VehicleAssignmentStatus {
  ACTIVE
  ENDED
}

model VehicleTransporterAssignment {
  id                        String                        @id @default(uuid()) @db.Uuid
  vehicleId                 String                        @db.Uuid @map("vehicle_id")
  transporterOrganisationId String                        @db.Uuid @map("transporter_organisation_id")
  relationshipType           VehicleAssignmentRelationship @default(SUBCONTRACTOR) @map("relationship_type")
  contractReference          String?                       @map("contract_reference")
  notes                      String?
  status                     VehicleAssignmentStatus       @default(ACTIVE)
  validFrom                  DateTime                      @default(now()) @map("valid_from") @db.Date
  validTo                    DateTime?                     @map("valid_to") @db.Date
  createdById                String                        @db.Uuid @map("created_by_id")
  createdAt                  DateTime                      @default(now()) @map("created_at")
  updatedAt                  DateTime                      @updatedAt @map("updated_at")
  vehicle                    Vehicle                       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  transporterOrganisation    Organisation                  @relation(fields: [transporterOrganisationId], references: [id])
  createdBy                  User                          @relation(fields: [createdById], references: [id])

  @@index([vehicleId, status])
  @@index([transporterOrganisationId, status])
  @@map("vehicle_transporter_assignments")
}

model Trailer {
  id              String   @id @default(uuid()) @db.Uuid
  vehicleId       String?  @db.Uuid @map("vehicle_id")
  trailerId       String   @unique @map("trailer_id")
  registrationNo  String?  @unique @map("registration_no")
  type            String?
  tareWeightKg    Int?     @map("tare_weight_kg")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  bookings        Booking[]
  transactions    WeighbridgeTransaction[]
  bookingTrailers BookingTrailer[]
  rostersAsTrailer1 FleetRoster[] @relation("Trailer1Roster")
  rostersAsTrailer2 FleetRoster[] @relation("Trailer2Roster")

  @@index([vehicleId])
  @@map("trailers")
}

model BookingTrailer {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid @map("booking_id")
  trailerId String   @db.Uuid @map("trailer_id")
  position  Int      @default(2)
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  trailer   Trailer  @relation(fields: [trailerId], references: [id])

  @@unique([bookingId, trailerId])
  @@map("booking_trailers")
}

model Driver {
  id                 String   @id @default(uuid()) @db.Uuid
  organisationId     String   @db.Uuid @map("organisation_id")
  firstName          String   @map("first_name")
  lastName           String   @map("last_name")
  idNumberEncrypted  String   @map("id_number_encrypted")
  idNumberHash       String   @unique @map("id_number_hash")
  rfidTag            String?  @unique @map("rfid_tag")
  photoUrl           String?  @map("photo_url")
  licenceNumber      String   @unique @map("licence_number")
  licenceExpiry      DateTime @db.Date @map("licence_expiry")
  blacklistStatus    Boolean  @default(false) @map("blacklist_status")
  blacklistReason    String?  @map("blacklist_reason")
  consentCapturedAt  DateTime @map("consent_captured_at")
  anomalyScore       Decimal  @default(0) @db.Decimal(8, 2) @map("anomaly_score")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  organisation       Organisation @relation(fields: [organisationId], references: [id])
  bookings           Booking[]
  transactions       WeighbridgeTransaction[]
  incidents          Incident[]
  rfidCredentials    RfidCredential[]
  fleetRosters       FleetRoster[]

  @@index([organisationId, blacklistStatus])
  @@index([licenceExpiry])
  @@map("drivers")
}

model Booking {
  id                        String        @id @default(uuid()) @db.Uuid
  reference                 String        @unique
  journeyToken              String        @unique @map("journey_token")
  transporterOrganisationId String        @db.Uuid @map("transporter_organisation_id")
  siteId                    String        @db.Uuid @map("site_id")
  vehicleId                 String        @db.Uuid @map("vehicle_id")
  trailerId                 String?       @db.Uuid @map("trailer_id")
  driverId                  String        @db.Uuid @map("driver_id")
  orderId                   String?       @db.Uuid @map("order_id")
  commodity                 String
  commodityDescription      String?       @map("commodity_description")
  targetTonnageKg           Int           @map("target_tonnage_kg")
  windowStart               DateTime      @map("window_start")
  windowEnd                 DateTime      @map("window_end")
  status                    BookingStatus @default(PENDING)
  approvalReason            String?       @map("approval_reason")
  rejectionReason           String?       @map("rejection_reason")
  createdById               String        @db.Uuid @map("created_by_id")
