  gateEvents          GateEvent[]

  @@index([siteId, capturedAt])
  @@index([vehicleId, capturedAt])
  @@index([bookingId])
  @@index([syncStatus])
  @@index([commodity, capturedAt])
  @@map("weighbridge_transactions")
}

