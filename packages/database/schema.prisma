enum RfidCredentialType {
  DRIVER
  TRUCK
}

enum RfidCredentialStatus {
  ACTIVE
  INACTIVE
  LOST
  STOLEN
  EXPIRED
  REPLACED
  BLOCKED
}

model RfidCredential {
  id                String               @id @default(uuid()) @db.Uuid
  uid               String               @unique
  displayCode       String?              @map("display_code")
  credentialType    RfidCredentialType   @map("credential_type")
  organisationId    String               @db.Uuid @map("organisation_id")
  siteId            String?              @db.Uuid @map("site_id")
  driverId          String?              @db.Uuid @map("driver_id")
  vehicleId         String?              @db.Uuid @map("vehicle_id")
  status            RfidCredentialStatus @default(ACTIVE)
  issuedAt          DateTime             @default(now()) @map("issued_at")
  expiresAt         DateTime?            @map("expires_at")
  activatedAt       DateTime?            @map("activated_at")
  deactivatedAt     DateTime?            @map("deactivated_at")
  replacedById      String?              @db.Uuid @map("replaced_by_id")
  replacementReason String?              @map("replacement_reason")
  notes             String?
  createdById       String               @db.Uuid @map("created_by_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  organisation      Organisation         @relation(fields: [organisationId], references: [id])
  site              Site?                @relation(fields: [siteId], references: [id])
  driver            Driver?              @relation(fields: [driverId], references: [id])
  vehicle           Vehicle?             @relation(fields: [vehicleId], references: [id])
  createdBy         User                 @relation("RfidCreator", fields: [createdById], references: [id])
  replacedBy        RfidCredential?      @relation("RfidReplacement", fields: [replacedById], references: [id])
  replacements      RfidCredential[]     @relation("RfidReplacement")

  @@index([uid, status])
  @@index([organisationId, credentialType])
  @@map("rfid_credentials")
}

